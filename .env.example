# ===================================================
# VEERIKA ROSE GARDEN - VERCEL ENVIRONMENT VARIABLES
# Copy these keys into: Vercel Dashboard → Project → Settings → Environment Variables
# ===================================================

# DATABASE (leave blank to use Firebase fallback)
DATABASE_URL=

# JWT & Cookie Secrets — USE STRONG RANDOM STRINGS IN PRODUCTION
JWT_ACCESS_SECRET=your_strong_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_strong_jwt_refresh_secret_here_min_32_chars
COOKIE_SECRET=your_strong_cookie_secret_here_minimum_32_chars

# Firebase (Firestore DB + Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini AI (Plant Care Expert)
GEMINI_API_KEY=

# PhonePe Payment Gateway
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_TPhhoBxVXsxTpD
RAZORPAY_KEY_SECRET=deYVUZfzzRp1mXaqioKd3GZw
VITE_RAZORPAY_KEY_ID=rzp_test_TPhhoBxVXsxTpD

# Server
NODE_ENV=production
CLIENT_URL=https://your-vercel-domain.vercel.app

# ─── WhatsApp Cloud API (Official Meta Business API) ───────────────────────
# Setup Guide:
#   1. Go to https://developers.facebook.com → Create App → Business → WhatsApp
#   2. Go to Meta Business Manager → System Users → Create System User
#   3. Generate a Permanent Token (never expires) with whatsapp_business_messaging permission
#   4. Copy the Phone Number ID from: App → WhatsApp → API Setup
#   5. Copy WABA ID from: Business Manager → WhatsApp accounts
#   6. Set VERIFY_TOKEN to any random string — use the SAME string in Meta dashboard webhook config
#   7. Create and get your message template approved under: WhatsApp Manager → Message Templates
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_VERIFY_TOKEN=your_random_webhook_secret_here
META_WA_TEMPLATE_NAME=order_confirmation
# Aliases used by whatsappCloudApi.ts (set same values as above)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_webhook_secret_here

# Initial Admin Account (seeds first SUPER_ADMIN on first login if not in DB)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Admin
ADMIN_INITIAL_PHONE=
