# ===================================================
# VEERIKA ROSE GARDEN - VERCEL ENVIRONMENT VARIABLES
# Copy these keys into: Vercel Dashboard → Project → Settings → Environment Variables
# ===================================================

# DATABASE (leave blank to use Firebase fallback)
DATABASE_URL=

# JWT & Cookie Secrets — USE STRONG RANDOM STRINGS IN PRODUCTION
JWT_ACCESS_SECRET=your_strong_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_strong_jwt_refresh_secret_here_min_32_chars
COOKIE_SECRET=your_strong_cookie_secret_here_minimum_32_chars

# Firebase (Firestore DB + Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini AI (Plant Care Expert)
GEMINI_API_KEY=

# PhonePe Payment Gateway
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=PRODUCTION

# Server
NODE_ENV=production
CLIENT_URL=https://your-vercel-domain.vercel.app

# Initial Admin Account (seeds first SUPER_ADMIN on first login if not in DB)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Admin
ADMIN_INITIAL_PHONE=
